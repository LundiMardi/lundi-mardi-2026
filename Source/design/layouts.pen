    {
      "type": "text",
      "id": "CtJjl",
      "x": 4279,
      "y": 683,
      "fill": "$color-black",
      "textGrowth": "fixed-width",
      "width": 378,
      "content": "When you find a solution, you would be surprised how often it's exact opposite works too\n\nThere are no problems only solutions\nThere are no problems only opportunities\nThere are no problems only questions\n\nLess is more, solve by subtraction\nComplexity might be the point",
      "lineHeight": 1.5,
      "fontFamily": "$font-native",
      "fontSize": "$text-size-5",
      "fontWeight": "normal"
    },
    {
      "type": "text",
