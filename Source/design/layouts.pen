              "children": [
                {
                  "type": "frame",
                  "id": "A01C8T",
                  "name": "Lundi Mardi designs interfaces and ident",
                  "context": "h1",
                  "width": 380,
                  "layout": "vertical",
                  "gap": "$space-2",
                  "children": [
                    {
                      "type": "text",
                      "id": "Y6lf7B",
                      "fill": "$color-black",
                      "textGrowth": "fixed-width",
                      "width": 378,
                      "content": "Hello,",
                      "lineHeight": 1.5,
                      "fontFamily": "$font-native",
                      "fontSize": "$text-size-5",
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "tFMrL",
                      "fill": "$color-black",
                      "textGrowth": "fixed-width",
                      "width": 378,
                      "content": "I'm a designer based in Lausanne. I help teams build digital systems for their users. I do the whole research – prototyping – testing loop, and I take care of the minute implementations details in production code.",
                      "lineHeight": 1.5,
                      "fontFamily": "$font-native",
                      "fontSize": "$text-size-5",
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "sTSdG",
                      "fill": "$color-black",
                      "textGrowth": "fixed-width",
                      "width": 378,
                      "content": "After two startups and independant practice I'm increasingly interested in the business side of products and companies.",
